  <typeSet id="typeSet" spec="TypeSet" typeTraitSet="@typeTraitSet"/>
  <processLength id="processLength" spec="ProcessLength" tree="@tree"/>

  <run id="mcmc" spec="MCMC" chainLength="2500000">
    <state id="state" storeEvery="5000">
      <stateNode id="birthRate" spec="RealParameter" lower="0.0" dimension="1">1.0</stateNode>
      <stateNode id="migrationRate" spec="RealParameter" lower="0.0" dimension="12">0.1</stateNode>
      <stateNode id="rootFreqs" spec="RealParameter" lower="0.0" upper="1.0" dimension="4">0.25</stateNode>
    </state>

    <distribution id="posterior" spec="CompoundDistribution">
      <distribution id="prior" spec="CompoundDistribution">
        <distribution id="birthRatePrior" spec="Prior" x="@birthRate">
          <distr spec="LogNormalDistributionModel" meanInRealSpace="false" M="0.0" S="1.0"/>
        </distribution>
        <distribution id="migrationRatePrior" spec="Prior" x="@migrationRate">
          <distr spec="Exponential" mean="0.3"/>
        </distribution>
        <distribution id="rootFreqsPrior" spec="Prior" x="@rootFreqs">
          <distr spec="Dirichlet"><parameter spec="RealParameter" name="alpha" value="1.0 1.0 1.0 1.0"/></distr>
        </distribution>
      </distribution>
      <distribution id="likelihood" spec="CompoundDistribution">
        <distribution id="treePrior" spec="BirthDeathMigrationDistribution" tree="@tree"
                      typeTraitSet="@typeTraitSet" startTypePriorProbs="@rootFreqs"
                      conditionOnRoot="true" parallelize="true">
          <parameterization id="param" spec="CanonicalParameterization" typeSet="@typeSet" processLength="@processLength">
            <birthRate spec="SkylineVectorParameter" typeSet="@typeSet" processLength="@processLength" skylineValues="@birthRate"/>
            <deathRate spec="SkylineVectorParameter" typeSet="@typeSet" processLength="@processLength">
              <skylineValues spec="RealParameter" value="0.0"/>
            </deathRate>
            <samplingRate spec="SkylineVectorParameter" typeSet="@typeSet" processLength="@processLength">
              <skylineValues spec="RealParameter" value="0.0"/>
            </samplingRate>
            <removalProb spec="SkylineVectorParameter" typeSet="@typeSet" processLength="@processLength">
              <skylineValues spec="RealParameter" value="1.0"/>
            </removalProb>
            <rhoSampling spec="TimedParameter" typeSet="@typeSet" processLength="@processLength" timesAreAges="true">
              <times spec="RealParameter" value="0.0"/>
              <values spec="RealParameter" value="1.0"/>
            </rhoSampling>
            <migrationRate spec="SkylineMatrixParameter" typeSet="@typeSet" processLength="@processLength" skylineValues="@migrationRate"/>
          </parameterization>
        </distribution>
      </distribution>
    </distribution>

    <operator id="birthRateScale" spec="ScaleOperator" parameter="@birthRate" scaleFactor="0.5" weight="3.0"/>
    <operator id="migRateScale" spec="ScaleOperator" parameter="@migrationRate" scaleFactor="0.5" weight="12.0"/>
    <operator id="migRateScaleAll" spec="ScaleOperator" parameter="@migrationRate" scaleAll="true" scaleFactor="0.75" weight="2.0"/>
    <operator id="rootFreqsExchange" spec="DeltaExchangeOperator" parameter="@rootFreqs" delta="0.2" weight="2.0"/>

    <logger id="tracelog" spec="Logger" fileName="bdmm_fixedtree_chain1.log" logEvery="500" sanitiseHeaders="true">
      <log idref="posterior"/>
      <log idref="likelihood"/>
      <log idref="prior"/>
      <log idref="treePrior"/>
      <log idref="birthRate"/>
      <log idref="migrationRate"/>
      <log idref="rootFreqs"/>
    </logger>
    <logger id="screenlog" spec="Logger" logEvery="25000">
      <log idref="posterior"/>
      <log idref="likelihood"/>
      <log spec="ESS" arg="@posterior"/>
    </logger>
  </run>
